// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//
// ENUMS
//
enum UserStatus {
  ARCHIVED
  CURRENT
}

enum ServiceSeekerStatus {
  LIVE
  PRE_ADMISSION
  ARCHIVED
  ARCHIVED_PRE_ADMISSION
  ON_HOLD_HOSPITAL
}

enum ChargeType {
  PER_HOUR
  PER_SHIFT
}

enum FunderPaymentType {
  PER_SHIFT
  BY_PERCENTAGE_SPENT
}

enum OutcomeCategory {
  ABOUT_ME
  PHYSICAL_HEALTH
  MENTAL_HEALTH
  COMMUNICATION
  ORAL_CARE
  SKIN_INTEGRITY
  MEDICATION
  NUTRITION_HYDRATION
  CONTINENCE_CARE
  MOBILITY
  MY_NEEDS_SUPPORT
  DECISION_MAKING
  EMOTIONAL_SUPPORT
}

enum ShiftRecurrence {
  DAILY
  WEEK
  TWO_WEEK
  THREE_WEEK
  FOUR_WEEK
  FIVE_WEEK
  SIX_WEEK
  SEVEN_WEEK
  EIGHT_WEEK
  NINE_WEEK
  TEN_WEEK
  TWO_DAY
  THREE_DAY
  FOUR_DAY
  FIVE_DAY
  SIX_DAY
}

enum CareerPayType {
  REGULAR
  BANK_HOLIDAY
}

enum PayCalculation {
  PER_HOUR
  PER_SHIFT
}

enum CalendarEntryType {
  MANAGEMENT_MEETING
  STAFF_MEETING
  RESIDENT_MEETING
  FAMILY_VISIT
  PROFESSIONAL_VISIT
  EVENT
}

enum QualityAssuranceType {
  COMPLIMENT
  SUGGESTION
  CONCERN
}

enum QualityAssuranceStatus {
  OPEN
  CLOSED
  IN_PROGRESS
}

enum MaintenanceIssueType {
  MAINTENANCE
  HEALTH_AND_SAFETY
  WELFARE
  OTHER
}

enum MaintenanceIssueRepeat {
  NO
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum PPStockTransactionAction {
  PURCHASE
  RESTOCK
  TAKEN
}

//
// MODELS
//

model RoleDefinition {
  id          Int      @id @default(autoincrement())
  name        String   @unique // e.g., "ADMIN", "CAREWORKER"
  displayName String // e.g., "Administrator", "Care Worker"
  description String?
  permissions Json // Array of permission strings
  isSystem    Boolean  @default(false) // System roles cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id               Int        @id @default(autoincrement())
  firstName        String
  lastName         String
  username         String     @unique
  phoneNo          String
  email            String     @unique
  roleId           Int
  password         String
  isEmailVerified  Boolean    @default(false)
  lastLoggedIn     DateTime?
  profilePic       String?
  employeeNumber   String?    @unique
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  startDate        DateTime?
  leaveDate        DateTime?
  regionId         Int?
  emergencyName    String?
  emergencyContact String?
  postalCode       String?
  contractedHours  Int?
  status           UserStatus
  niNumber         String?

  // Relations
  role          RoleDefinition @relation(fields: [roleId], references: [id])
  region        Region?        @relation(fields: [regionId], references: [id])
  documents     Document[]     @relation("UserDocuments")
  uploadedDocs  Document[]     @relation("UploadedByUser")
  standByShifts StandByShift[]

  permissions UserPermission[]

  // Audit relations
  createdServiceSeekers            ServiceSeeker[]            @relation("ServiceSeekerCreatedBy")
  updatedServiceSeekers            ServiceSeeker[]            @relation("ServiceSeekerUpdatedBy")
  createdBathingTasks              BathingTask[]              @relation("BathingTaskCreatedBy")
  updatedBathingTasks              BathingTask[]              @relation("BathingTaskUpdatedBy")
  createdBehaviourTasks            BehaviourTask[]            @relation("BehaviourTaskCreatedBy")
  updatedBehaviourTasks            BehaviourTask[]            @relation("BehaviourTaskUpdatedBy")
  createdBloodTestTasks            BloodTestTask[]            @relation("BloodTestTaskCreatedBy")
  updatedBloodTestTasks            BloodTestTask[]            @relation("BloodTestTaskUpdatedBy")
  createdBloodPressureTasks        BloodPressureTask[]        @relation("BloodPressureTaskCreatedBy")
  updatedBloodPressureTasks        BloodPressureTask[]        @relation("BloodPressureTaskUpdatedBy")
  createdComfortCheckTasks         ComfortCheckTask[]         @relation("ComfortCheckTaskCreatedBy")
  updatedComfortCheckTasks         ComfortCheckTask[]         @relation("ComfortCheckTaskUpdatedBy")
  createdCommunicationNotesTasks   CommunicationNotesTask[]   @relation("CommunicationNotesTaskCreatedBy")
  updatedCommunicationNotesTasks   CommunicationNotesTask[]   @relation("CommunicationNotesTaskUpdatedBy")
  createdFamilyPhotoMessageTasks   FamilyPhotoMessageTask[]   @relation("FamilyPhotoMessageTaskCreatedBy")
  updatedFamilyPhotoMessageTasks   FamilyPhotoMessageTask[]   @relation("FamilyPhotoMessageTaskUpdatedBy")
  createdFoodDrinkTasks            FoodDrinkTask[]            @relation("FoodDrinkTaskCreatedBy")
  updatedFoodDrinkTasks            FoodDrinkTask[]            @relation("FoodDrinkTaskUpdatedBy")
  createdGeneralSupportTasks       GeneralSupportTask[]       @relation("GeneralSupportTaskCreatedBy")
  updatedGeneralSupportTasks       GeneralSupportTask[]       @relation("GeneralSupportTaskUpdatedBy")
  createdHouseKeepingTasks         HouseKeepingTask[]         @relation("HouseKeepingTaskCreatedBy")
  updatedHouseKeepingTasks         HouseKeepingTask[]         @relation("HouseKeepingTaskUpdatedBy")
  witnessedIncidentFallTasks       IncidentFallTask[]         @relation("IncidentFallTaskWitnessedBy")
  createdIncidentFallTasks         IncidentFallTask[]         @relation("IncidentFallTaskCreatedBy")
  updatedIncidentFallTasks         IncidentFallTask[]         @relation("IncidentFallTaskUpdatedBy")
  signoffMedicinePrnTasks          MedicinePrnTask[]          @relation("MedicinePrnTaskSignoffBy")
  createdMedicinePrnTasks          MedicinePrnTask[]          @relation("MedicinePrnTaskCreatedBy")
  updatedMedicinePrnTasks          MedicinePrnTask[]          @relation("MedicinePrnTaskUpdatedBy")
  createdMuacTasks                 MuacTask[]                 @relation("MuacTaskCreatedBy")
  updatedMuacTasks                 MuacTask[]                 @relation("MuacTaskUpdatedBy")
  createdObservationTasks          ObservationTask[]          @relation("ObservationTaskCreatedBy")
  updatedObservationTasks          ObservationTask[]          @relation("ObservationTaskUpdatedBy")
  createdOneToOneTasks             OneToOneTask[]             @relation("OneToOneTaskCreatedBy")
  updatedOneToOneTasks             OneToOneTask[]             @relation("OneToOneTaskUpdatedBy")
  createdOralCareTasks             OralCareTask[]             @relation("OralCareTaskCreatedBy")
  updatedOralCareTasks             OralCareTask[]             @relation("OralCareTaskUpdatedBy")
  createdOxygenTasks               OxygenTask[]               @relation("OxygenTaskCreatedBy")
  updatedOxygenTasks               OxygenTask[]               @relation("OxygenTaskUpdatedBy")
  createdPersonCentredTasks        PersonCentredTask[]        @relation("PersonCentredTaskCreatedBy")
  updatedPersonCentredTasks        PersonCentredTask[]        @relation("PersonCentredTaskUpdatedBy")
  createdPhysicalInterventionTasks PhysicalInterventionTask[] @relation("PhysicalInterventionTaskCreatedBy")
  updatedPhysicalInterventionTasks PhysicalInterventionTask[] @relation("PhysicalInterventionTaskUpdatedBy")
  createdPulseTasks                PulseTask[]                @relation("PulseTaskCreatedBy")
  updatedPulseTasks                PulseTask[]                @relation("PulseTaskUpdatedBy")
  createdRepositionTasks           RepositionTask[]           @relation("RepositionTaskCreatedBy")
  updatedRepositionTasks           RepositionTask[]           @relation("RepositionTaskUpdatedBy")
  createdSpendingMoneyTasks        SpendingMoneyTask[]        @relation("SpendingMoneyTaskCreatedBy")
  updatedSpendingMoneyTasks        SpendingMoneyTask[]        @relation("SpendingMoneyTaskUpdatedBy")
  createdStoolTasks                StoolTask[]                @relation("StoolTaskCreatedBy")
  updatedStoolTasks                StoolTask[]                @relation("StoolTaskUpdatedBy")
  createdTemperatureTasks          TemperatureTask[]          @relation("TemperatureTaskCreatedBy")
  updatedTemperatureTasks          TemperatureTask[]          @relation("TemperatureTaskUpdatedBy")
  createdVisitTasks                VisitTask[]                @relation("VisitTaskCreatedBy")
  updatedVisitTasks                VisitTask[]                @relation("VisitTaskUpdatedBy")
  createdWeightTasks               WeightTask[]               @relation("WeightTaskCreatedBy")
  updatedWeightTasks               WeightTask[]               @relation("WeightTaskUpdatedBy")
  createdEncouragementTasks        EncouragementTask[]        @relation("EncouragementTaskCreatedBy")
  updatedEncouragementTasks        EncouragementTask[]        @relation("EncouragementTaskUpdatedBy")
  createdFollowUpTasks             FollowUpTask[]             @relation("FollowUpTaskCreatedBy")
  updatedFollowUpTasks             FollowUpTask[]             @relation("FollowUpTaskUpdatedBy")

  // Rota relations
  createdShiftRuns      ShiftRun[]                         @relation("ShiftRunCreatedBy")
  updatedShiftRuns      ShiftRun[]                         @relation("ShiftRunUpdatedBy")
  createdShifts         Shift[]                            @relation("ShiftCreatedBy")
  updatedShifts         Shift[]                            @relation("ShiftUpdatedBy")
  shiftAssignments      ShiftAssignment[]                  @relation("ShiftAssignments")
  clockInOuts           ClockInOut[]                       @relation("ClockInOuts")
  externalInboxAccesses ServiceSeekerExternalInboxAccess[]

  // Team
  teamId Int?
  team   Team? @relation(fields: [teamId], references: [id])

  // Chat/Messaging relations
  conversations ConversationParticipant[]
  sentMessages  Message[]

  // Holiday relations
  holidays         Holiday[] @relation("UserHolidays")
  approvedHolidays Holiday[] @relation("ApprovedHolidays")

  // Calendar entry relations
  eventCareWorkerEntries   ServiceSeekerCalendarEntry[] @relation("EventCareWorker")
  createdCalendarEntries   ServiceSeekerCalendarEntry[] @relation("CalendarEntryCreatedBy")
  updatedCalendarEntries   ServiceSeekerCalendarEntry[] @relation("CalendarEntryUpdatedBy")
  createdHolidays          Holiday[]                    @relation("HolidayCreatedBy")
  updatedHolidays          Holiday[]                    @relation("HolidayUpdatedBy")
  createdQualityAssurances QualityAssurance[]           @relation("QualityAssuranceCreatedBy")
  updatedQualityAssurances QualityAssurance[]           @relation("QualityAssuranceUpdatedBy")
  createdMaintenanceIssues MaintenanceIssue[]           @relation("MaintenanceIssueCreatedBy")
  updatedMaintenanceIssues MaintenanceIssue[]           @relation("MaintenanceIssueUpdatedBy")
  createdPolicies          Policy[]                     @relation("PolicyCreatedBy")
  updatedPolicies          Policy[]                     @relation("PolicyUpdatedBy")
  policyReviews            PolicyReview[]               @relation("PolicyReviewCreatedBy")
  policySignatures         PolicySignature[]            @relation("PolicySignatureUser")
  ppStockTransactions      PPStockTransaction[]         @relation("PPStockTransactionUser")
  createdHandovers         Handover[]                   @relation("HandoverCreatedBy")
  triggeredEmergencies     EmergencyAlert[]             @relation("EmergencyTriggeredBy")
  acknowledgedEmergencies  EmergencyAlert[]             @relation("EmergencyAcknowledgedBy")

  notifications            Notification[]
  pushSubscriptions        PushSubscription[]
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  members         User[]
  emergencyAlerts EmergencyAlert[]
}

model UserPermission {
  id     Int    @id @default(autoincrement())
  userId Int
  key    String // flexible permission key (admin defines)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, key]) // prevent duplicate permissions for same user
}

model Document {
  id         Int @id @default(autoincrement())
  userId     Int // document belongs to this user
  uploadedBy Int // uploaded by which user

  fileUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user     User @relation("UserDocuments", fields: [userId], references: [id])
  uploader User @relation("UploadedByUser", fields: [uploadedBy], references: [id])
}

model Region {
  id        Int      @id @default(autoincrement())
  title     String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model DailyTask {
  id        Int      @id @default(autoincrement())
  taskTitle String
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceSeeker {
  id            Int                 @id @default(autoincrement())
  firstName     String
  lastName      String
  postalCode    String?
  address       String?
  latitude      Float?
  longitude     Float?
  photoUrl      String?
  photoDate     DateTime?
  title         String?
  preferredName String?
  dateOfBirth   DateTime?
  gender        String?
  genderAtBirth String?
  pronouns      String?
  dnar          Boolean?
  sexuality     String?
  status        ServiceSeekerStatus
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  createdById   Int?
  updatedById   Int?

  shifts                    Shift[]
  clockInOuts               ClockInOut[]
  bathingTasks              BathingTask[]
  behaviourTasks            BehaviourTask[]
  bloodTestTasks            BloodTestTask[]
  bloodPressureTasks        BloodPressureTask[]
  comfortCheckTasks         ComfortCheckTask[]
  communicationNotesTasks   CommunicationNotesTask[]
  familyPhotoMessageTasks   FamilyPhotoMessageTask[]
  foodDrinkTasks            FoodDrinkTask[]
  generalSupportTasks       GeneralSupportTask[]
  houseKeepingTasks         HouseKeepingTask[]
  incidentFallTasks         IncidentFallTask[]
  medicinePrnTasks          MedicinePrnTask[]
  muacTasks                 MuacTask[]
  observationTasks          ObservationTask[]
  oneToOneTasks             OneToOneTask[]
  oralCareTasks             OralCareTask[]
  oxygenTasks               OxygenTask[]
  personCentredTasks        PersonCentredTask[]
  physicalInterventionTasks PhysicalInterventionTask[]
  pulseTasks                PulseTask[]
  repositionTasks           RepositionTask[]
  spendingMoneyTasks        SpendingMoneyTask[]
  stoolTasks                StoolTask[]
  temperatureTasks          TemperatureTask[]
  visitTasks                VisitTask[]
  weightTasks               WeightTask[]
  encouragementTasks        EncouragementTask[]
  followUpTasks             FollowUpTask[]
  residentMeetings          ServiceSeekerResidentMeeting[]
  calendarEntries           ServiceSeekerCalendarEntry[]          @relation("CalendarEntries")
  outcomes                  ServiceSeekerOutcome[]
  riskAssessments           ServiceSeekerRiskAssessment[]
  safeguardingIncidents     ServiceSeekerSafeguarding[]
  feedbackForms             ServiceSeekerFeedback[]
  marReviews                ServiceSeekerMarReview[]
  alertThresholds           ServiceSeekerAlertThreshold[]
  mustAssessments           ServiceSeekerMustAssessment[]
  waterlowAssessments       ServiceSeekerWaterlowAssessment[]
  personalProperties        ServiceSeekerPersonalProperty[]
  externalLogins            ServiceSeekerExternalLogin[]
  externalInboxAccesses     ServiceSeekerExternalInboxAccess[]
  allowanceSettings         ServiceSeekerAllowanceSettings?
  allowanceTransactions     ServiceSeekerAllowanceTransaction[]
  handovers                 Handover[]
  foodDrinksSchedules       ServiceSeekerFoodDrinksSchedule[]
  foodDrinksSettings        ServiceSeekerFoodDrinksSettings?
  houseKeepingSchedules     ServiceSeekerHouseKeepingSchedule[]
  socialVisitInstructions   ServiceSeekerSocialVisitInstructions?
  medicineAccessCodes       ServiceSeekerMedicineAccessCodes?
  medicineSchedule          ServiceSeekerMedicineSchedule[]
  medicinePrnPlans          ServiceSeekerMedicinePrnPlan[]
  oralCareSchedule          ServiceSeekerOralCareSchedule[]
  oralCareDefaultTimes      ServiceSeekerOralCareDefaultTime[]
  positioningHandling       ServiceSeekerPositioningHandling[]
  bathingSchedule           ServiceSeekerBathingSchedule?
  bathingDefaultTimes       ServiceSeekerBathingDefaultTime[]
  encouragementSchedules    ServiceSeekerEncouragementSchedule[]
  stoolSchedules            ServiceSeekerStoolSchedule[]
  weightSchedules           ServiceSeekerWeightSchedule[]
  muacSchedules             ServiceSeekerMuacSchedule[]
  personCentredSchedules    ServiceSeekerPersonCentredSchedule[]

  // Relations
  createdBy         User?                           @relation("ServiceSeekerCreatedBy", fields: [createdById], references: [id])
  updatedBy         User?                           @relation("ServiceSeekerUpdatedBy", fields: [updatedById], references: [id])
  admission         ServiceSeekerAdmission?
  otherIds          ServiceSeekerOtherId[]
  otherTelephones   ServiceSeekerOtherTelephone[]
  otherAddresses    ServiceSeekerOtherAddress[]
  healthTags        ServiceSeekerHealthTag[]
  mentalCapacities  ServiceSeekerMentalCapacity[]
  mcaAssessments    ServiceSeekerMcaAssessment[]
  contacts          ServiceSeekerContact[]
  documents         ServiceSeekerDocument[]
  confidentialNotes ServiceSeekerConfidentialNote[]
  fundings          ServiceSeekerFunding[]
}

enum FuneralArrangement {
  UNKNOWN
  BURIAL
  CREMATION
}

model ServiceSeekerAdmission {
  id                      Int                 @id @default(autoincrement())
  serviceSeekerId         Int                 @unique
  advancedCarePlanUrl     String?
  startDate               DateTime?
  banding                 String?
  authorityCategory       String?
  funeralArrangement      FuneralArrangement?
  funeralDirector         String?
  sleepInNight            String? // "Yes", "No"
  hoursPerDay             Float?
  teamId                  Int?
  defaultShiftRunId       Int?
  // Identification fields
  nhsHscNo                String?
  chiNumber               String?
  niNumber                String?
  personId                String?
  // Council fields
  councilServiceUserId    String?
  councilCareProviderId   String?
  serviceType             String?
  serviceLevel            String?
  // Background fields
  maritalStatus           String?
  religion                String?
  ethnicity               String?
  communicationPreference String?
  emergencyRating         String?
  addressLine1            String?
  addressLine2            String?
  addressLine3            String?
  addressLine4            String?
  addressLine5            String?
  postcode                String?
  addressLatitude         String?
  addressLongitude        String?
  region                  String?
  keySafeCode             String?
  accessDetails           String?
  telephone               String?
  mobile                  String?
  email                   String?
  preferredContactMethod  String?
  // Health fields
  height                  Float?
  weight                  Float?
  bmi                     Float?
  medicalHistory          String?
  medicineAllergies       String?
  oxygen                  String?
  onCatheter              String?
  teamInvolvement         Json? // Array of selected team involvement options
  // Diet fields
  foodAllergies           String?
  nilByMouth              String?
  mainDiet                String?
  specialDiet             String?
  dietInstructions        String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  // Relations
  serviceSeeker   ServiceSeeker @relation(fields: [serviceSeekerId], references: [id])
  defaultShiftRun ShiftRun?     @relation(fields: [defaultShiftRunId], references: [id])
}

model ServiceSeekerOtherId {
  id              Int      @id @default(autoincrement())
  serviceSeekerId Int
  idName          String
  idNumber        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  serviceSeeker ServiceSeeker @relation(fields: [serviceSeekerId], references: [id])

  @@index([serviceSeekerId])
}

model ServiceSeekerOtherTelephone {
  id              Int      @id @default(autoincrement())
  serviceSeekerId Int
  telephoneType   String
  number          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  serviceSeeker ServiceSeeker @relation(fields: [serviceSeekerId], references: [id])

  @@index([serviceSeekerId])
}

model ServiceSeekerOtherAddress {
  id              Int      @id @default(autoincrement())
  serviceSeekerId Int
  addressType     String
  addressLine1    String?
  addressLine2    String?
  addressLine3    String?
  addressLine4    String?
  addressLine5    String?
  postcode        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  serviceSeeker ServiceSeeker @relation(fields: [serviceSeekerId], references: [id])

  @@index([serviceSeekerId])
}

model ServiceSeekerHealthTag {
  id              Int      @id @default(autoincrement())
  serviceSeekerId Int
  tagName         String
  isCustom        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  serviceSeeker ServiceSeeker @relation(fields: [serviceSeekerId], references: [id])

  @@index([serviceSeekerId])
}

model Diet {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SpecialDiet {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceSeekerMentalCapacity {
  id                 Int       @id @default(autoincrement())
  serviceSeekerId    Int
  mca                DateTime?
  capacity           String?
  bestInterests      String?
  score              String?
  dols               String?
  appliedForDate     DateTime?
  dolsStartDate      DateTime?
  dolsEndDate        DateTime?
  dolsNotes          String?
  cqcInformed        Boolean?  @default(false)
  dolsAppliedForDate DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  serviceSeeker ServiceSeeker @relation(fields: [serviceSeekerId], references: [id])

  @@index([serviceSeekerId])
}

model ServiceSeekerMcaAssessment {
  id                                Int       @id @default(autoincrement())
  serviceSeekerId                   Int
  risk                              String?
  lastAssessed                      DateTime?
  triggeredBy                       String?
  hasImpairment                     String?
  clinicalDiagnosis                 String?   @db.Text
  decisionToMake                    String?   @db.Text
  isImpairment                      String?
  fluctuatingCapacity               String?
  fluctuatingCapacityReason         String?   @db.Text
  generalUnderstanding              String?
  generalUnderstandingDetails       String?   @db.Text
  canRetainInformation              String?
  canRetainInformationDetails       String?   @db.Text
  canUseWeighInformation            String?
  canUseWeighInformationDetails     String?   @db.Text
  canCommunicate                    String?
  healthWelfareLpa                  String?
  advancedDecision                  String?
  deputyAppointed                   String?
  imcaRequired                      String?
  imcaName                          String?
  imcaTelephone                     String?
  option1                           String?   @db.Text
  option2                           String?   @db.Text
  option3                           String?   @db.Text
  pastPresentWishes                 String?
  pastPresentWishesDetails          String?   @db.Text
  consultedInterestedParties        String?
  consultedInterestedPartiesDetails String?   @db.Text
  consultedProfessionals            String?
  consultedProfessionalsDetails     String?   @db.Text
  bestInterestDecision              String?   @db.Text
  decisionMade                      String?   @db.Text
  leastRestrictivePrinciple         String?   @db.Text
  disagreement                      String?
  disagreementDetails               String?   @db.Text
  everyOptionExplored               String?
  patientRecordsUpdated             String?
  useOfRestraint                    String?
  misinformation                    String?
  anyoneObjected                    String?
  restraintForTreatment             String?
  relativesRequestedDischarge       String?
  restrictedAccessToFamily          String?
  leastRestrictiveOptions           String?
  restrictedAccessToCommunity       String?
  continuousSupervision             String?
  riskLevel                         String?
  totalScore                        String?
  staffTeam                         String?
  office                            String?
  sendSignoffs                      String?
  conductedBy                       String?
  createdAt                         DateTime  @default(now())
  updatedAt                         DateTime  @updatedAt

  // Relations
  serviceSeeker ServiceSeeker @relation(fields: [serviceSeekerId], references: [id])

  @@index([serviceSeekerId])
}

model ServiceSeekerContact {
  id               Int      @id @default(autoincrement())
  serviceSeekerId  Int
  contactType      String // FAMILY or PROFESSIONAL
  name             String
  role             String?
  otherRole        String?
  mobile           String?
  work             String?
  home             String?
  email            String?
  address          String?  @db.Text
  practiceCode     String?
  emergencyContact Boolean? @default(false)
  pictureUrl       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  serviceSeeker ServiceSeeker @relation(fields: [serviceSeekerId], references: [id])

  @@index([serviceSeekerId])
}

model ServiceSeekerDocument {
  id              Int      @id @default(autoincrement())
  serviceSeekerId Int
  docType         String
  name            String
  fileUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  serviceSeeker ServiceSeeker @relation(fields: [serviceSeekerId], references: [id])

  @@index([serviceSeekerId])
}

model ServiceSeekerConfidentialNote {
  id              Int      @id @default(autoincrement())
  serviceSeekerId Int
  noteDate        DateTime
  staffName       String?
  notes           String?  @db.Text
  pictureUrl      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  serviceSeeker ServiceSeeker @relation(fields: [serviceSeekerId], references: [id])

  @@index([serviceSeekerId])
}

model Funder {
  id             Int               @id @default(autoincrement())
  fundingSource  String
  contractNumber String
  serviceType    String
  costNotes      String?
  paymentType    FunderPaymentType
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  shifts Shift[]
}

model FundingSource {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  organisation String?
  contact      String?
  email        String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  serviceSeekerFundings ServiceSeekerFunding[]
}

model ServiceSeekerFunding {
  id              Int               @id @default(autoincrement())
  serviceSeekerId Int
  fundingSourceId Int
  percentageSplit Float?
  contractNumber  String?
  typeOfService   String?
  costNotes       String?
  paymentType     FunderPaymentType
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  serviceSeeker ServiceSeeker @relation(fields: [serviceSeekerId], references: [id])
  fundingSource FundingSource @relation(fields: [fundingSourceId], references: [id])

  @@index([serviceSeekerId])
  @@index([fundingSourceId])
}

model StandByShift {
  id                      Int        @id @default(autoincrement())
  caretakerId             Int
  date                    DateTime
  startTime               DateTime
  endTime                 DateTime
  workDetail              String
  stay                    Boolean
  caretakerPayRegular     Float
  caretakerPayBankHoliday Float
  carerPayBy              ChargeType

  // Relations
  caretaker User @relation(fields: [caretakerId], references: [id])
}

enum BathingType {
  BATH
  BEDWASH
  FULL_BODY_WASH
  LOWER_BODY_WASH
  SHOWER
  STRIP_WASH
}

enum ComplianceStatus {
