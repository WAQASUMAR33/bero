model Conversation {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  participants ConversationParticipant[]
  messages     Message[]

  @@index([updatedAt])
}

model ConversationParticipant {
  id             Int       @id @default(autoincrement())
  conversationId Int
  userId         Int
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String   @db.Text
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

// Holiday Models
model HolidayType {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isPaid      Boolean  @default(true)
  color       String? // Hex color for calendar display
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  holidays Holiday[]

  @@index([name])
}

model Holiday {
  id              Int       @id @default(autoincrement())
  userId          Int
  holidayTypeId   Int
  startDate       DateTime
  endDate         DateTime
  startTime       String? // Optional time (HH:mm format)
  endTime         String? // Optional time (HH:mm format)
  includeWeekends Boolean   @default(false)
  description     String?   @db.Text
  holidayHours    Float? // Total hours for the holiday
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedById    Int?
  approvedAt      DateTime?
  rejectionReason String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     Int
  updatedById     Int

  // Relations
  user        User        @relation("UserHolidays", fields: [userId], references: [id])
  holidayType HolidayType @relation(fields: [holidayTypeId], references: [id])
  approvedBy  User?       @relation("ApprovedHolidays", fields: [approvedById], references: [id])
  createdBy   User        @relation("HolidayCreatedBy", fields: [createdById], references: [id])
  updatedBy   User        @relation("HolidayUpdatedBy", fields: [updatedById], references: [id])

  @@index([userId])
  @@index([startDate])
  @@index([endDate])
  @@index([status])
  @@index([holidayTypeId])
}

model QualityAssurance {
  id            Int                    @id @default(autoincrement())
  date          DateTime
  type          QualityAssuranceType
  from          String // Who it's from (service user name, external person, etc.)
  youSaid       String?                @db.Text // What they said
  weDid         String?                @db.Text // What we did
  lessonsLearnt String?                @db.Text // Lessons learnt
  status        QualityAssuranceStatus @default(OPEN)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  createdById   Int
  updatedById   Int

  // Relations
  createdBy User @relation("QualityAssuranceCreatedBy", fields: [createdById], references: [id])
  updatedBy User @relation("QualityAssuranceUpdatedBy", fields: [updatedById], references: [id])

  @@index([date])
  @@index([type])
  @@index([status])
  @@index([createdById])
}

// Policy and Procedures Models
model Policy {
  id           Int       @id @default(autoincrement())
  name         String
  fileName     String // Name of the uploaded file
  fileUrl      String? // URL to the PDF file (pending upload system)
  reviewIn     Int? // Days until next review (e.g., 30, 90, 365)
  lastReviewed DateTime? // When the policy was last reviewed
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  Int
  updatedById  Int

  // Relations
  createdBy  User              @relation("PolicyCreatedBy", fields: [createdById], references: [id])
  updatedBy  User              @relation("PolicyUpdatedBy", fields: [updatedById], references: [id])
  reviews    PolicyReview[]
  signatures PolicySignature[]

  @@index([createdById])
  @@index([updatedById])
}

model PolicyReview {
  id          Int      @id @default(autoincrement())
  policyId    Int
  reviewText  String   @db.Text
  createdAt   DateTime @default(now())
  createdById Int

  // Relations
  policy    Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  createdBy User   @relation("PolicyReviewCreatedBy", fields: [createdById], references: [id])

  @@index([policyId])
  @@index([createdById])
}

model PolicySignature {
  id       Int      @id @default(autoincrement())
  policyId Int
  userId   Int
  signedAt DateTime @default(now())

  // Relations
  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user   User   @relation("PolicySignatureUser", fields: [userId], references: [id])

  @@unique([policyId, userId])
  @@index([policyId])
  @@index([userId])
}

// Maintenance Issues Model
model MaintenanceIssue {
  id          Int                    @id @default(autoincrement())
  issueType   MaintenanceIssueType
  for         String? // For field (optional)
  issue       String                 @db.Text // Issue description
  repeats     MaintenanceIssueRepeat @default(NO)
  issueDate   DateTime
  completed   String                 @default("NO") // "YES" or "NO"
  photoUrls   String?                @db.Text // JSON array of photo URLs (pending)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  createdById Int
  updatedById Int

  // Relations
  createdBy User @relation("MaintenanceIssueCreatedBy", fields: [createdById], references: [id])
  updatedBy User @relation("MaintenanceIssueUpdatedBy", fields: [updatedById], references: [id])

  @@index([issueType])
  @@index([completed])
  @@index([issueDate])
  @@index([createdById])
}

model PPProduct {
  id              Int      @id @default(autoincrement())
  name            String
  threshold       Int      @default(0) // Minimum quantity before alerting
  currentQuantity Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  transactions PPStockTransaction[]

  @@index([name])
}

model PPStockTransaction {
  id        Int                      @id @default(autoincrement())
  productId Int
  action    PPStockTransactionAction
  quantity  Int
  userId    Int
  createdAt DateTime                 @default(now())

  // Relations
  product PPProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User      @relation("PPStockTransactionUser", fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([createdAt])
}

model Handover {
  id                    Int      @id @default(autoincrement())
  fromShiftAssignmentId Int // Shift assignment being handed over FROM
  toShiftAssignmentId   Int // Shift assignment receiving handover TO
  serviceSeekerId       Int // Must match between both shifts (validation)
  handoverNotes         String?  @db.Text // General handover notes
  remainingTasks        Json? // Array of task references (taskType, taskId)
  visits                Json? // Array of visit references (visitTask IDs)
  issues                String?  @db.Text // Service user issues/concerns
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  createdById           Int // User creating the handover

  // Relations
  fromShiftAssignment ShiftAssignment @relation("HandoverFromShift", fields: [fromShiftAssignmentId], references: [id])
  toShiftAssignment   ShiftAssignment @relation("HandoverToShift", fields: [toShiftAssignmentId], references: [id])
  serviceSeeker       ServiceSeeker   @relation(fields: [serviceSeekerId], references: [id])
  createdBy           User            @relation("HandoverCreatedBy", fields: [createdById], references: [id])

  @@index([fromShiftAssignmentId])
  @@index([toShiftAssignmentId])
  @@index([serviceSeekerId])
  @@index([createdAt])
}

enum EmergencyAlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

model EmergencyAlert {
  id             Int                  @id @default(autoincrement())
  triggeredBy    Int // User who triggered the emergency
  teamId         Int? // Team of the user who triggered
  status         EmergencyAlertStatus @default(ACTIVE)
  location       String? // GPS location if available
  message        String? // Optional message from care worker
  acknowledgedBy Int? // User who acknowledged
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  // Relations
  triggeredByUser    User  @relation("EmergencyTriggeredBy", fields: [triggeredBy], references: [id])
  acknowledgedByUser User? @relation("EmergencyAcknowledgedBy", fields: [acknowledgedBy], references: [id])
  team               Team? @relation(fields: [teamId], references: [id])

  @@index([status])
  @@index([teamId])
  @@index([createdAt])
  @@index([triggeredBy])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  type      String   @default("INFO") // INFO, WARNING, SUCCESS, ERROR
  isRead    Boolean  @default(false)
  link      String?
  deletedAt DateTime? // For recycle bin functionality
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
}

// Push notification subscriptions for desktop and mobile
model PushSubscription {
  id            Int      @id @default(autoincrement())
  userId        Int
  endpoint      String   @db.Text
  endpointHash  String   @db.VarChar(64) // SHA256 hash for unique constraint
  p256dh        String   @db.Text  // Public key
  auth          String   @db.VarChar(255)  // Auth secret (short enough for VarChar)
  deviceType    String   @default("desktop") // desktop, mobile, tablet
  userAgent     String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastUsedAt    DateTime?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpointHash])
  @@index([userId])
  @@index([isActive])
}


